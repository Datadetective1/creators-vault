# ---------------------------------------------------------------------------
# Creator Vault — environment template
# Copy to `.env.local` and fill in. NEVER commit a filled-in file.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Public origin, used for auth redirects. No trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paddle ----------------------------------------------------------------
# Paddle Dashboard (sandbox) > Developer Tools
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Price id for the one paid tier (Creator, up to 100 GB). PLACEHOLDER — leave
# empty until the pilot price is confirmed and the product exists in Paddle.
# While it is empty, billing stays off and checkout returns 503.
PADDLE_CREATOR_PRICE_ID=

# --- Admin -----------------------------------------------------------------
# Comma-separated list of emails allowed to view /admin. Optional.
ADMIN_EMAILS=
