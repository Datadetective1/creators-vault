# ---------------------------------------------------------------------------
# Creator Lock — environment template
# Copy to `.env.local` and fill in. NEVER commit a filled-in file.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Public origin, used for auth redirects. No trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paddle ----------------------------------------------------------------
# Billing is OFF unless PADDLE_API_KEY, NEXT_PUBLIC_PADDLE_CLIENT_TOKEN and
# PADDLE_CREATOR_PRICE_ID are all set — checkout then returns 503.
#
# Everything is environment-driven: no Paddle IDs or API hosts are hard-coded.
# "sandbox" uses sandbox-api.paddle.com and test_ client tokens;
# "production" uses api.paddle.com and live_ client tokens.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token (test_… in sandbox, live_… in production).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server-only API key (pdl_sdbx_… or pdl_live_…). Never NEXT_PUBLIC_.
PADDLE_API_KEY=
# Signing secret of the notification destination (endpoint_secret_key).
PADDLE_WEBHOOK_SECRET=
# Price id of the Creator plan (US$4/month + tax, up to 100 GB).
PADDLE_CREATOR_PRICE_ID=
# Webhook source-IP allowlist from Paddle's /ips endpoint. Enforced on Vercel
# by default; set 1 to enforce locally, 0 to switch it off.
PADDLE_WEBHOOK_ENFORCE_IPS=

# Local-only, read by scripts/paddle-live-setup.mjs. Do not add this name to
# Vercel: when live billing is approved, its value goes to Vercel Production as
# PADDLE_API_KEY (see docs/PADDLE_GO_LIVE.md).
PADDLE_LIVE_API_KEY=

# --- Admin -----------------------------------------------------------------
# Comma-separated list of emails allowed to view /admin. Optional.
ADMIN_EMAILS=
